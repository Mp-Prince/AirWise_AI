# AirWise AI backend environment variables
# Copy to .env and fill in real values. NEVER commit .env.

APP_NAME=AirWise AI
APP_ENV=development
API_V1_PREFIX=/api/v1

# --- PostgreSQL + pgvector ---
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/airwise_ai

# --- Authentication / JWT ---
SECRET_KEY=replace_with_a_secure_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (frontend origin) ---
CORS_ORIGINS=http://localhost:5173

# --- External providers (keys stay server-side only) ---
# Configure only the variables for providers actually selected (Phase 3 / 5).
OPENAQ_API_KEY=
GEOCODING_API_KEY=
LLM_API_KEY=
EMBEDDING_API_KEY=
